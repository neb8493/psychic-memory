# Copy to .env and fill in. .env is gitignored — it never gets committed.
#
#   cp .env.example .env
#   $EDITOR .env
#
# A variable exported in your shell overrides whatever is in .env.

# From https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# The elderly Scottish grandfather voice. Run `python render.py --list-voices`
# to print every voice on the account with its id. You can also leave this
# blank and pass the voice name to --voice instead.
ELEVENLABS_VOICE_ID=
